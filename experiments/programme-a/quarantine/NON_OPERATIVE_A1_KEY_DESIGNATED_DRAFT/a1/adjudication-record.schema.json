{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firstcall.programmeA.a1_adjudication_record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "block", "adjudicator", "identity_partition", "predicates", "fatal_stop", "deviation", "pages_used", "minutes_used", "evidence_sha256", "sealed_utc", "record_sha256"],
  "properties": {
    "key": {"type": "string"},
    "block": {"type": "integer", "minimum": 0},
    "adjudicator": {"enum": ["ADJ-1", "ADJ-2"]},
    "identity_partition": {"type": ["object", "null"], "description": "{platforms: [[keys]...], UNRESOLVED: [keys]} for the key's whole component; null if the component was already sealed"},
    "predicates": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^(I[1-4]|E[1-4]|E6|T[1-3]|C0[1-7])$": {"enum": ["TRUE", "FALSE", "UNRESOLVED", null]}}
    },
    "fatal_stop": {"enum": [null, "INCLUSION_FALSE:I1", "INCLUSION_FALSE:I2", "INCLUSION_FALSE:I3", "INCLUSION_FALSE:I4", "E1", "E2", "E3", "E4", "E6", "T1", "T2", "T3"]},
    "deviation": {"type": "boolean"},
    "pages_used": {"type": "object"},
    "minutes_used": {"type": "object"},
    "evidence_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "sealed_utc": {"type": "string"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
